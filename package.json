{
  "name": "shotcandy",
  "version": "0.2.0",
  "private": true,
  "description": "Turn any screenshot into a beautiful, share-ready image. Free, open source, runs entirely in your browser.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-brand-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-brand-assets.mjs",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=engine --project=app --project=app-firefox --project=app-webkit",
    "test:e2e:update": "pnpm build && playwright test --project=engine --project=app --update-snapshots",
    "bench": "playwright test --project=bench",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:presets": "node scripts/sync-design-presets.mjs"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@shikijs/langs": "4.4.3",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "idb": "^8.0.3",
    "mediabunny": "1.60.0",
    "mp4-muxer": "5.2.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "webm-muxer": "5.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
